{
	"authentication_portals": [
		{
			"name": "myportal",
			"ui": {},
			"user_transformer_configs": [
				{
					"matchers": [
						"exact match realm local",
						"field email exists"
					],
					"actions": [
						"require auth challenges u2f or totp",
						"require auth challenges password if u2f and totp not available",
						"action add role authp/member",
						"add label \"Member {claims.sub}\" as string",
						"add teams \"one team\" two as string list",
						"add nested metadata label with \"literal value\" as string",
						"action delete org"
					]
				},
				{
					"matchers": [
						"match any"
					],
					"actions": [
						"ui link \"User Profile\" /auth/profile/ icon \"las la-cog\""
					]
				}
			],
			"cookie_config": {
				"session_id_cookie_name": "AUTHP_SESSION_ID",
				"referer_cookie_name": "AUTHP_REDIRECT_URL",
				"sandbox_id_cookie_name": "AUTHP_SANDBOX_ID",
				"identity_token_cookie_name": "AUTHP_ID_TOKEN",
				"access_token_cookie_name": "AUTHP_ACCESS_TOKEN",
				"refresh_token_cookie_name": "AUTHP_REFRESH_TOKEN",
				"oidc_session_id_cookie_name": "AUTHP_OIDC_SESSION_ID",
				"oidc_request_id_cookie_name": "AUTHP_OIDC_REQUEST_ID",
				"saml_session_id_cookie_name": "AUTHP_SAML_SESSION_ID",
				"cookie_name_prefix": "AUTHP"
			},
			"identity_stores": [
				"localdb"
			],
			"token_validator_options": {},
			"raw_crypto_key_store_config": [
				"crypto key sign-verify synthetic-challenge-signing-key"
			],
			"crypto_key_store_config": {
				"raw_key_configs": [
					"crypto key sign-verify synthetic-challenge-signing-key"
				],
				"auto_generate_tag": "default",
				"auto_generate_algo": "ES512"
			},
			"token_grantor_options": {},
			"portal_admin_roles": {
				"authp/admin": true
			},
			"portal_user_roles": {
				"authp/user": true
			},
			"portal_guest_roles": {
				"authp/guest": true
			},
			"api": {
				"profile_enabled": true
			}
		}
	],
	"authorization_policies": [
		{
			"name": "factor_policy",
			"auth_url_path": "/auth",
			"auth_redirect_query_param": "redirect_url",
			"auth_redirect_status_code": 302,
			"access_list_rules": [
				{
					"conditions": [
						"match amr otp hwk"
					],
					"action": "allow stop"
				}
			],
			"raw_crypto_key_store_config": [
				"crypto key verify synthetic-challenge-signing-key"
			],
			"crypto_key_store_config": {
				"raw_key_configs": [
					"crypto key verify synthetic-challenge-signing-key"
				],
				"auto_generate_tag": "default",
				"auto_generate_algo": "ES512"
			},
			"validate_bearer_header": true,
			"api_key_header_name": "X-Api-Key",
			"auth_realm_header_name": "X-Auth-Realm",
			"session_id_cookie_name": "AUTHP_SESSION_ID",
			"access_token_cookie_names": [
				"AUTHP_ACCESS_TOKEN",
				"access_token",
				"jwt_access_token"
			]
		}
	],
	"identity_stores": [
		{
			"name": "localdb",
			"kind": "local",
			"params": {
				"path": "users.json",
				"realm": "local",
				"users": [
					{
						"auth_challenge_rules": [
							"u2f",
							"password totp if u2f not available",
							"password if u2f and totp not available"
						],
						"password": "SyntheticPassword42!",
						"roles": [
							"authp/user"
						],
						"username": "alice"
					}
				]
			}
		},
		{
			"name": "directory",
			"kind": "ldap",
			"params": {
				"bind_password": "SyntheticBindPassword42!",
				"bind_username": "cn=service,dc=example,dc=test",
				"fallback_roles": [
					"authp/user",
					"directory/member"
				],
				"full_automatic_group_mapping_enabled": true,
				"realm": "directory",
				"search_base_dn": "dc=example,dc=test",
				"servers": [
					{
						"address": "ldaps://ldap.example.test"
					}
				]
			}
		}
	]
}