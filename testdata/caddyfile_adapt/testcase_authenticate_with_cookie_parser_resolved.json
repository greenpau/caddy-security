{
    "authentication_portals": [
        {
            "name": "myportal",
            "ui": {},
            "cookie_config": {
                "domains": {
                    "example.com": {
                        "domain": "example.com",
                        "path": "/app",
                        "lifetime": 600,
                        "same_site": "Strict",
                        "strip_domain_enabled": true
                    },
                    "sub.example.com": {
                        "seq": 1,
                        "domain": "sub.example.com",
                        "path": "/sub"
                    }
                },
                "path": "/app with spaces",
                "lifetime": 3600,
                "same_site": "Lax",
                "strip_domain_enabled": true,
                "session_id_cookie_name": "AUTHP_SESSION_ID",
                "referer_cookie_name": "AUTHP_LOGIN_REDIRECT",
                "sandbox_id_cookie_name": "AUTHP_LOGIN_SANDBOX",
                "identity_token_cookie_name": "AUTHP_LOGIN_IDENTITY",
                "access_token_cookie_name": "AUTHP_LOGIN_ACCESS",
                "refresh_token_cookie_name": "AUTHP_LOGIN_REFRESH",
                "oidc_session_id_cookie_name": "AUTHP_LOGIN_SESSION",
                "oidc_request_id_cookie_name": "AUTHP_LOGIN_REQUEST",
                "cookie_name_prefix": "AUTHP"
            },
            "identity_stores": [
                "localdb"
            ],
            "token_validator_options": {},
            "raw_crypto_key_store_config": [
                "crypto key sign-verify synthetic-cookie-signing-key"
            ],
            "crypto_key_store_config": {
                "raw_key_configs": [
                    "crypto key sign-verify synthetic-cookie-signing-key"
                ],
                "auto_generate_tag": "default",
                "auto_generate_algo": "ES512"
            },
            "token_grantor_options": {},
            "portal_admin_roles": {
                "authp/admin": true
            },
            "portal_user_roles": {
                "authp/user": true
            },
            "portal_guest_roles": {
                "authp/guest": true
            },
            "api": {
                "profile_enabled": true
            }
        },
