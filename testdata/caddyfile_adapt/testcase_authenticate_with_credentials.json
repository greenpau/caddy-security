{
    "apps": {
        "http": {
            "servers": {
                "srv0": {
                    "listen": [
                        ":443"
                    ],
                    "routes": [
                        {
                            "handle": [
                                {
                                    "handler": "authenticator",
                                    "portal_name": "myportal",
                                    "route_matcher": "*"
                                }
                            ]
                        }
                    ]
                }
            }
        },
        "security": {
            "config": {
                "credentials": {
                    "raw_credential_configs": [
                        [
                            "name root@localhost",
                            "username root",
                            "password {env.FOO_PASSWORD}"
                        ],
                        [
                            "name {env.FOO_USERNAME}",
                            "username foo",
                            "password {env.FOO_PASSWORD}",
                            "domain {env.FOO_DOMAIN}"
                        ],
                        [
                            "name literal",
                            "username literal",
                            "password \"synthetic \"\"literal\"\" password with spaces\""
                        ]
                    ]
                },
                "authentication_portals": [
                    {
                        "name": "myportal",
                        "ui": {},
                        "identity_stores": [
                            "localdb"
                        ],
                        "token_validator_options": {},
                        "raw_crypto_key_store_config": [
                            "crypto key sign-verify {env.JWT_SHARED_KEY}"
                        ],
                        "crypto_key_store_config": {
                            "raw_key_configs": [
                                "crypto key sign-verify {env.JWT_SHARED_KEY}"
                            ],
                            "auto_generate_tag": "default",
                            "auto_generate_algo": "ES512"
                        },
                        "token_grantor_options": {},
                        "portal_admin_roles": {
                            "authp/admin": true
                        },
                        "portal_user_roles": {
                            "authp/user": true
                        },
                        "portal_guest_roles": {
                            "authp/guest": true
                        },
                        "api": {
                            "profile_enabled": true
                        }
                    }
                ],
                "identity_stores": [
                    {
                        "name": "local",
                        "kind": "local",
                        "params": {
                            "path": "assets/config/users.json",
                            "realm": "local"
                        }
                    }
                ]
            },
            "portal_cookie_directives": {
                "myportal": [
                    "cookie domain {env.GLOBAL_APP_DOMAIN}"
                ]
            }
        }
    }
}
