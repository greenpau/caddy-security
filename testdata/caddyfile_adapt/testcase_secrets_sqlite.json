{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "app.example.test"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "gatekeeper_name": "app_policy",
                                  "handler": "authorization",
                                  "route_matcher": "*"
                                },
                                {
                                  "body": "protected resource",
                                  "handler": "static_response"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "security": {
      "config": {
        "authorization_policies": [
          {
            "name": "app_policy",
            "auth_url_path": "/auth",
            "auth_redirect_query_param": "redirect_url",
            "auth_redirect_status_code": 302,
            "access_list_rules": [
              {
                "conditions": [
                  "match roles viewer"
                ],
                "action": "allow log debug"
              }
            ],
            "raw_crypto_key_store_config": [
              "crypto key verify secrets:signing:secret.key"
            ],
            "crypto_key_store_config": {
              "raw_key_configs": [
                "crypto key verify secrets:signing:secret.key"
              ],
              "auto_generate_tag": "default",
              "auto_generate_algo": "ES512"
            },
            "validate_bearer_header": true,
            "api_key_header_name": "X-Api-Key",
            "auth_realm_header_name": "X-Auth-Realm"
          }
        ]
      },
      "secrets_managers": [
        {
          "driver": "sqlite",
          "name": "signing",
          "path": "/private secrets/secrets.db",
          "record": "access",
          "timeout": "750ms"
        }
      ]
    }
  }
}
