{
  "authorization_policies": [
    {
      "oauth": {
        "identity_provider": "linkedin",
        "base_path": "/_authcrunch/oauth2/linkedin_oauth_policy",
        "session_cookie_name": "AUTHZ_linkedin_oauth_policy_SESSION",
        "login_cookie_name": "AUTHZ_linkedin_oauth_policy_LOGIN",
        "session_lifetime": 900,
        "max_sessions": 10000,
        "max_pending_logins": 1024
      },
      "name": "linkedin_oauth_policy",
      "auth_url_path": "/auth",
      "auth_redirect_query_param": "redirect_url",
      "auth_redirect_status_code": 302,
      "access_list_rules": [
        {
          "conditions": [
            "match roles authp/admin authp/user"
          ],
          "action": "allow log debug"
        }
      ],
      "crypto_key_store_config": {
        "auto_generate_tag": "default",
        "auto_generate_algo": "ES512"
      },
      "api_key_header_name": "X-Api-Key",
      "auth_realm_header_name": "X-Auth-Realm"
    }
  ],
  "identity_stores": [
    {
      "name": "accounts",
      "kind": "local",
      "params": {
        "path": ":memory:",
        "realm": "local"
      }
    },
    {
      "name": "directory",
      "kind": "ldap",
      "params": {
        "attachment": {
          "local_identity_store": "accounts"
        },
        "bind_password": "synthetic-bind-password",
        "bind_username": "cn=service,dc=example,dc=test",
        "realm": "directory",
        "search_base_dn": "dc=example,dc=test",
        "servers": [
          {
            "address": "ldaps://directory.example.test"
          }
        ],
        "short_automatic_group_mapping_enabled": true
      }
    }
  ],
  "identity_providers": [
    {
      "name": "saml",
      "kind": "saml",
      "params": {
        "acs_urls": [
          "https://portal.example.test/auth/saml/saml",
          "https://other.example.test/auth/saml/saml"
        ],
        "attachment": {
          "local_identity_store": "accounts"
        },
        "driver": "generic",
        "entity_id": "urn:caddy:attachment-test",
        "idp_login_url": "https://issuer.example.test/sso",
        "idp_sign_cert_location": "/not-opened/idp.pem",
        "realm": "saml"
      }
    },
    {
      "name": "linkedin",
      "kind": "oauth",
      "params": {
        "attachment": {
          "local_identity_store": "accounts"
        },
        "base_auth_url": "https://www.linkedin.com/oauth/",
        "client_id": "synthetic-client",
        "client_secret": "synthetic-secret",
        "driver": "linkedin",
        "identity_token_field_name": "id_token",
        "login_icon": {
          "background_color": "#1e88e5",
          "class_name": "lab la-linkedin la-2x",
          "color": "white",
          "text": "LinkedIn",
          "text_color": "#37474f"
        },
        "metadata_url": "https://www.linkedin.com/oauth/.well-known/openid-configuration",
        "realm": "linkedin",
        "required_token_fields": [
          "access_token",
          "id_token"
        ],
        "response_type": [
          "code"
        ],
        "scopes": [
          "openid",
          "email",
          "profile"
        ]
      }
    }
  ]
}
