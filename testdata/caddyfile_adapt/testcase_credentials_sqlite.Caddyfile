{
	security {
		credential authenticator sqlite keys {
			path "/private keys/credentials.db"
			realm staff
			timeout 750ms
		}
		authorization policy app_policy {
			crypto key verify fixture-signing-secret
			with api key auth portal keys realm staff
			allow roles viewer
			disable auth redirect
		}
	}
}

https://app.example.test {
	route {
		authorize with app_policy
		respond "protected resource"
	}
}
