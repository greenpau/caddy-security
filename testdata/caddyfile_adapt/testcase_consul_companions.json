{
	"apps": {
		"security": {
			"config": {},
			"identity_stores": [
				{
					"capacity": 8,
					"driver": "consul",
					"name": "accounts",
					"prefix": "custom/accounts",
					"realm": "staff",
					"timeout": "2s"
				}
			],
			"identity_providers": [
				{
					"base_path": "/auth",
					"capacity": 8,
					"cookie_name": "AUTHP_PROVIDER_SESSION_ID",
					"driver": "consul",
					"issuer_url": "https://issuer.example.test/signin",
					"name": "tickets",
					"prefix": "custom/tickets",
					"public_origin": "https://auth.example.test",
					"realm": "application",
					"timeout": "2s"
				}
			],
			"refresh_stores": [
				{
					"driver": "consul",
					"max_rotations": 128,
					"max_sessions": 1000,
					"name": "sessions",
					"prefix": "security/refresh",
					"timeout": "3s"
				}
			]
		}
	}
}
