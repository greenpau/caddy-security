{
	"apps": {
		"security": {
			"config": {},
			"secrets_managers": [
				{
					"driver": "consul",
					"name": "signing",
					"prefix": "private/secrets",
					"record": "tokens",
					"timeout": "2s"
				}
			],
			"credential_authenticators": [
				{
					"capacity": 8,
					"driver": "consul",
					"name": "keys",
					"prefix": "private/credentials",
					"realm": "staff",
					"timeout": "2s"
				}
			]
		}
	}
}
