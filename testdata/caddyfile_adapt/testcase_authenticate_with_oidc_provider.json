{
	"admin": {
		"disabled": true,
		"config": {
			"persist": false
		}
	},
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":9080"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"127.0.0.1"
									]
								}
							],
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"handle": [
																{
																	"handler": "headers",
																	"response": {
																		"require": {
																			"headers": {
																				"Content-Security-Policy": [
																					"default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
																				],
																				"Content-Type": [
																					"text/html; charset=utf-8"
																				],
																				"Referrer-Policy": [
																					"no-referrer"
																				]
																			},
																			"status_code": [
																				200
																			]
																		},
																		"set": {
																			"Content-Security-Policy": [
																				"default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://rp.example.test"
																			],
																			"Referrer-Policy": [
																				"same-origin"
																			]
																		}
																	}
																}
															],
															"match": [
																{
																	"method": [
																		"GET"
																	],
																	"path": [
																		"/other/oidc/authorize",
																		"/other/oidc/continue"
																	]
																}
															]
														},
														{
															"handle": [
																{
																	"handler": "authenticator",
																	"portal_name": "defaults",
																	"route_matcher": "*"
																}
															]
														}
													]
												}
											],
											"match": [
												{
													"path": [
														"/other/*"
													]
												}
											]
										},
										{
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"handle": [
																{
																	"handler": "headers",
																	"response": {
																		"require": {
																			"headers": {
																				"Content-Security-Policy": [
																					"default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
																				],
																				"Content-Type": [
																					"text/html; charset=utf-8"
																				],
																				"Referrer-Policy": [
																					"no-referrer"
																				]
																			},
																			"status_code": [
																				200
																			]
																		},
																		"set": {
																			"Content-Security-Policy": [
																				"default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://rp.example.test"
																			],
																			"Referrer-Policy": [
																				"same-origin"
																			]
																		}
																	}
																}
															],
															"match": [
																{
																	"method": [
																		"GET"
																	],
																	"path": [
																		"/auth/oidc/authorize",
																		"/auth/oidc/continue"
																	]
																}
															]
														},
														{
															"handle": [
																{
																	"handler": "authenticator",
																	"portal_name": "myportal",
																	"route_matcher": "*"
																}
															]
														}
													]
												}
											],
											"match": [
												{
													"path": [
														"/auth/*"
													]
												}
											]
										}
									]
								}
							],
							"terminal": true
						}
					],
					"automatic_https": {
						"disable": true,
						"skip": [
							"127.0.0.1"
						]
					}
				}
			}
		},
