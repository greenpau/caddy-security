{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":8443"
          ],
          "routes": [
            {
              "match": [
                {
                  "path": [
                    "/auth/*"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "authenticator",
                          "portal_name": "myportal",
                          "route_matcher": "*"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "security": {
      "config": {
        "authentication_portals": [
          {
            "name": "myportal",
            "ui": {},
            "cookie_config": {
              "session_id_cookie_name": "AUTHP_SESSION_ID",
              "referer_cookie_name": "AUTHP_REDIRECT_URL",
              "sandbox_id_cookie_name": "AUTHP_SANDBOX_ID",
              "identity_token_cookie_name": "AUTHP_ID_TOKEN",
              "access_token_cookie_name": "AUTHP_ACCESS_TOKEN",
              "refresh_token_cookie_name": "AUTHP_REFRESH_TOKEN",
              "oidc_session_id_cookie_name": "AUTHP_OIDC_SESSION_ID",
              "oidc_request_id_cookie_name": "AUTHP_OIDC_REQUEST_ID",
              "saml_session_id_cookie_name": "AUTHP_SAML_SESSION_ID",
              "cross_device_session_id_cookie_name": "AUTHP_CROSS_DEVICE_SESSION_ID",
              "cookie_name_prefix": "AUTHP"
            },
            "identity_stores": [
              "localdb"
            ],
            "token_validator_options": {},
            "raw_crypto_key_store_config": [
              "crypto key sign-verify synthetic-argon2-fixture-signing-key"
            ],
            "crypto_key_store_config": {
              "raw_key_configs": [
                "crypto key sign-verify synthetic-argon2-fixture-signing-key"
              ],
              "auto_generate_tag": "default",
              "auto_generate_algo": "ES512"
            },
            "token_grantor_options": {},
            "portal_admin_roles": {
              "authp/admin": true
            },
            "portal_user_roles": {
              "authp/user": true
            },
            "portal_guest_roles": {
              "authp/guest": true
            },
            "api": {
              "profile_enabled": true
            }
          }
        ],
        "identity_stores": [
          {
            "name": "localdb",
            "kind": "local",
            "params": {
              "path": "users.json",
              "realm": "local",
              "users": [
                {
                  "email_address": "alice@example.test",
                  "password": "argon2:$argon2id$v=19$m=1024,t=2,p=2$mjBUxIgaxCd2UQA9tzdTUQ$z5MrHTVraToXYev67Zg47cpvqEWp/WufD0u4oyK+V+c",
                  "password_overwrite_enabled": true,
                  "roles": [
                    "authp/user"
                  ],
                  "username": "alice"
                },
                {
                  "email_address": "environment@example.test",
                  "password": "argon2:$argon2id$v=19$m=1024,t=2,p=2$mjBUxIgaxCd2UQA9tzdTUQ$z5MrHTVraToXYev67Zg47cpvqEWp/WufD0u4oyK+V+c",
                  "roles": [
                    "authp/user"
                  ],
                  "username": "environment"
                },
                {
                  "email_address": "runtime@example.test",
                  "password": "{env.SECURITY_ARGON2_PASSWORD}",
                  "roles": [
                    "authp/user"
                  ],
                  "username": "runtime"
                },
                {
                  "email_address": "bob@example.test",
                  "password": "bcrypt:8:$2a$08$CiSseGjDibS3jp0ZVKut/u1BdLXh9UgaixdLkr9VUWk.zvCSBeOP.",
                  "roles": [
                    "authp/user"
                  ],
                  "username": "bob"
                },
                {
                  "email_address": "plain@example.test",
                  "password": "PlaintextFixturePassword42!",
                  "roles": [
                    "authp/user"
                  ],
                  "username": "plain"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
