{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":8443"
					],
					"routes": [
						{
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"handle": [
																{
																	"handler": "authenticator",
																	"portal_name": "ed25519",
																	"route_matcher": "*"
																}
															]
														}
													]
												}
											],
											"match": [
												{
													"path": [
														"/auth",
														"/auth/*"
													]
												}
											]
										},
										{
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"handle": [
																{
																	"handler": "authentication",
																	"providers": {
																		"authorizer": {
																			"gatekeeper_name": "ed25519",
																			"route_matcher": "*"
																		}
																	}
																},
																{
																	"body": "allowed",
																	"handler": "static_response"
																}
															]
														}
													]
												}
											]
										}
									]
								}
							]
						}
					]
				}
			}
		},
