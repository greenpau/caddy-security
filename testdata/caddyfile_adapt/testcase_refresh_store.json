{
	"admin": {
		"disabled": true,
		"config": {
			"persist": false
		}
	},
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":443"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"auth.example.test"
									]
								}
							],
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"handle": [
																{
																	"handler": "authenticator",
																	"portal_name": "myportal",
																	"route_matcher": "*"
																}
															]
														}
													]
												}
											],
											"match": [
												{
													"path": [
														"/auth/*"
													]
												}
											]
										}
									]
								}
							],
							"terminal": true
						}
					],
					"tls_connection_policies": [
						{}
					],
					"automatic_https": {
						"disable": true
					}
				}
			}
		},
		"security": {
			"config": {
				"state": {
					"directory": "/var/lib/authcrunch/runtime"
				},
				"authentication_portals": [
					{
						"name": "myportal",
						"ui": {},
						"cookie_config": {
							"session_id_cookie_name": "AUTHP_SESSION_ID",
							"referer_cookie_name": "AUTHP_REDIRECT_URL",
							"sandbox_id_cookie_name": "AUTHP_SANDBOX_ID",
							"identity_token_cookie_name": "AUTHP_ID_TOKEN",
							"access_token_cookie_name": "AUTHP_ACCESS_TOKEN",
							"refresh_token_cookie_name": "AUTHP_REFRESH_TOKEN",
							"oidc_session_id_cookie_name": "AUTHP_OIDC_SESSION_ID",
							"oidc_request_id_cookie_name": "AUTHP_OIDC_REQUEST_ID",
							"saml_session_id_cookie_name": "AUTHP_SAML_SESSION_ID",
							"cross_device_session_id_cookie_name": "AUTHP_CROSS_DEVICE_SESSION_ID",
							"cookie_name_prefix": "AUTHP"
						},
						"identity_stores": [
							"employeesdb"
						],
						"token_validator_options": {},
						"crypto_key_store_config": {
							"auto_generate_tag": "default",
							"auto_generate_algo": "ES512"
						},
						"token_grantor_options": {},
						"portal_admin_roles": {
							"authp/admin": true
						},
						"portal_user_roles": {
							"authp/user": true
						},
						"portal_guest_roles": {
							"authp/guest": true
						},
						"api": {
							"profile_enabled": true
						},
						"refresh_tokens": {
							"store": "sessions",
							"enabled": true,
							"realms": [
								"employees"
							],
							"public_origin": "https://auth.example.test",
							"base_path": "/auth",
							"access_lifetime_seconds": 300,
							"idle_timeout_seconds": 1800,
							"absolute_timeout_seconds": 28800,
							"max_sessions": 2,
							"max_rotations": 3
						}
					},
					{
						"name": "deferred",
						"ui": {},
						"identity_stores": [
							"employeesdb"
						],
						"token_validator_options": {},
						"crypto_key_store_config": {
							"auto_generate_tag": "default",
							"auto_generate_algo": "ES512"
						},
						"token_grantor_options": {},
						"portal_admin_roles": {
							"authp/admin": true
						},
						"portal_user_roles": {
							"authp/user": true
						},
						"portal_guest_roles": {
							"authp/guest": true
						},
						"api": {
							"profile_enabled": true
						}
					}
				],
				"identity_stores": [
					{
						"name": "employeesdb",
						"kind": "local",
						"params": {
							"path": "/var/lib/authcrunch/users.json",
							"realm": "employees"
						}
					}
				]
			},
			"portal_cookie_directives": {
				"deferred": null
			},
			"portal_token_refresh_directives": {
				"deferred": [
					"store {env.REFRESH_STORE_NAME}",
					"realms employees",
					"public origin https://auth.example.test",
					"base path /deferred",
					"max sessions {env.REFRESH_STORE_SESSIONS}",
					"max rotations {env.REFRESH_STORE_ROTATIONS}"
				]
			},
			"refresh_stores": [
				{
					"driver": "sqlite",
					"max_rotations": 3,
					"max_sessions": 2,
					"name": "sessions",
					"path": "/var/lib/authcrunch/refresh.db",
					"timeout": "1s"
				}
			]
		}
	}
}
