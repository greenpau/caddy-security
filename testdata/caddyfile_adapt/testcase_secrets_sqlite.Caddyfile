{
	security {
		secrets sqlite signing {
			path "/private secrets/secrets.db"
			record access
			timeout 750ms
		}
		authorization policy app_policy {
			crypto key verify secrets:signing:secret.key
			validate bearer header
			allow roles viewer
		}
	}
}

https://app.example.test {
	route {
		authorize with app_policy
		respond "protected resource"
	}
}
