{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":8443"
					],
					"routes": [
						{
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"base_path": "/tenant/auth",
													"handler": "authenticator",
													"portal_name": "literal",
													"route_matcher": "*"
												}
											],
											"match": [
												{
													"path": [
														"/tenant/auth",
														"/tenant/auth/*"
													]
												}
											]
										},
										{
											"handle": [
												{
													"base_path": "/",
													"handler": "authenticator",
													"portal_name": "deferred",
													"route_matcher": "*"
												}
											]
										}
									]
								}
							]
						}
					]
				}
			}
		},
		"security": {
			"config": {
				"authentication_portals": [
					{
						"name": "literal",
						"ui": {},
						"cookie_config": {
							"session_id_cookie_name": "AUTHP_SESSION_ID",
							"referer_cookie_name": "AUTHP_REDIRECT_URL",
							"sandbox_id_cookie_name": "AUTHP_SANDBOX_ID",
							"identity_token_cookie_name": "AUTHP_ID_TOKEN",
							"access_token_cookie_name": "AUTHP_ACCESS_TOKEN",
							"refresh_token_cookie_name": "AUTHP_REFRESH_TOKEN",
							"oidc_session_id_cookie_name": "AUTHP_OIDC_SESSION_ID",
							"oidc_request_id_cookie_name": "AUTHP_OIDC_REQUEST_ID",
							"saml_session_id_cookie_name": "AUTHP_SAML_SESSION_ID",
							"cross_device_session_id_cookie_name": "AUTHP_CROSS_DEVICE_SESSION_ID",
							"cookie_name_prefix": "AUTHP"
						},
						"identity_stores": [
							"localdb"
						],
						"token_validator_options": {},
						"crypto_key_store_config": {
							"auto_generate_tag": "default",
							"auto_generate_algo": "ES512"
						},
						"token_grantor_options": {},
						"portal_admin_roles": {
							"authp/admin": true
						},
						"portal_user_roles": {
							"authp/user": true
						},
						"portal_guest_roles": {
							"authp/guest": true
						},
						"api": {
							"profile_enabled": true,
							"admin_enabled": true,
							"documents_enabled": true
						},
						"documents": {
							"database": "/private/caddy documents/literal.db",
							"public_origin": "https://localhost:8443",
							"base_path": "/tenant/auth",
							"realms": [
								"local"
							],
							"max_file_bytes": 32,
							"max_user_bytes": 64,
							"max_total_bytes": 128,
							"max_user_files": 2,
							"max_total_files": 3,
							"max_keys": 4,
							"max_recipients": 2,
							"upload_ttl_seconds": 60
						}
					},
					{
						"name": "deferred",
						"ui": {},
						"cookie_config": {
							"session_id_cookie_name": "AUTHP_SESSION_ID",
							"referer_cookie_name": "AUTHP_REDIRECT_URL",
							"sandbox_id_cookie_name": "AUTHP_SANDBOX_ID",
							"identity_token_cookie_name": "AUTHP_ID_TOKEN",
							"access_token_cookie_name": "AUTHP_ACCESS_TOKEN",
							"refresh_token_cookie_name": "AUTHP_REFRESH_TOKEN",
							"oidc_session_id_cookie_name": "AUTHP_OIDC_SESSION_ID",
							"oidc_request_id_cookie_name": "AUTHP_OIDC_REQUEST_ID",
							"saml_session_id_cookie_name": "AUTHP_SAML_SESSION_ID",
							"cross_device_session_id_cookie_name": "AUTHP_CROSS_DEVICE_SESSION_ID",
							"cookie_name_prefix": "AUTHP"
						},
						"identity_stores": [
							"localdb"
						],
						"token_validator_options": {},
						"crypto_key_store_config": {
							"auto_generate_tag": "default",
							"auto_generate_algo": "ES512"
						},
						"token_grantor_options": {},
						"portal_admin_roles": {
							"authp/admin": true
						},
						"portal_user_roles": {
							"authp/user": true
						},
						"portal_guest_roles": {
							"authp/guest": true
						},
						"api": {
							"profile_enabled": true
						}
					},
					{
						"name": "disabled",
						"ui": {},
						"cookie_config": {
							"session_id_cookie_name": "AUTHP_SESSION_ID",
							"referer_cookie_name": "AUTHP_REDIRECT_URL",
							"sandbox_id_cookie_name": "AUTHP_SANDBOX_ID",
							"identity_token_cookie_name": "AUTHP_ID_TOKEN",
							"access_token_cookie_name": "AUTHP_ACCESS_TOKEN",
							"refresh_token_cookie_name": "AUTHP_REFRESH_TOKEN",
							"oidc_session_id_cookie_name": "AUTHP_OIDC_SESSION_ID",
							"oidc_request_id_cookie_name": "AUTHP_OIDC_REQUEST_ID",
							"saml_session_id_cookie_name": "AUTHP_SAML_SESSION_ID",
							"cross_device_session_id_cookie_name": "AUTHP_CROSS_DEVICE_SESSION_ID",
							"cookie_name_prefix": "AUTHP"
						},
						"identity_stores": [
							"localdb"
						],
						"token_validator_options": {},
						"crypto_key_store_config": {
							"auto_generate_tag": "default",
							"auto_generate_algo": "ES512"
						},
						"token_grantor_options": {},
						"portal_admin_roles": {
							"authp/admin": true
						},
						"portal_user_roles": {
							"authp/user": true
						},
						"portal_guest_roles": {
							"authp/guest": true
						},
						"api": {
							"profile_enabled": true
						},
						"documents": {
							"database": "relative-unused"
						}
					},
					{
						"name": "storageonly",
						"ui": {},
						"cookie_config": {
							"session_id_cookie_name": "AUTHP_SESSION_ID",
							"referer_cookie_name": "AUTHP_REDIRECT_URL",
							"sandbox_id_cookie_name": "AUTHP_SANDBOX_ID",
							"identity_token_cookie_name": "AUTHP_ID_TOKEN",
							"access_token_cookie_name": "AUTHP_ACCESS_TOKEN",
							"refresh_token_cookie_name": "AUTHP_REFRESH_TOKEN",
							"oidc_session_id_cookie_name": "AUTHP_OIDC_SESSION_ID",
							"oidc_request_id_cookie_name": "AUTHP_OIDC_REQUEST_ID",
							"saml_session_id_cookie_name": "AUTHP_SAML_SESSION_ID",
							"cross_device_session_id_cookie_name": "AUTHP_CROSS_DEVICE_SESSION_ID",
							"cookie_name_prefix": "AUTHP"
						},
						"identity_stores": [
							"localdb"
						],
						"token_validator_options": {},
						"crypto_key_store_config": {
							"auto_generate_tag": "default",
							"auto_generate_algo": "ES512"
						},
						"token_grantor_options": {},
						"portal_admin_roles": {
							"authp/admin": true
						},
						"portal_user_roles": {
							"authp/user": true
						},
						"portal_guest_roles": {
							"authp/guest": true
						},
						"api": {
							"profile_enabled": true
						},
						"documents": {
							"database": "ignored",
							"base_path": "unused"
						}
					}
				],
				"identity_stores": [
					{
						"name": "localdb",
						"kind": "local",
						"params": {
							"path": ":memory:",
							"realm": "local"
						}
					}
				]
			},
			"portal_documents_directives": {
				"deferred": [
					"enable documents api",
					"documents api database {env.DOCUMENTS_FIXTURE_DATABASE}",
					"documents api public origin {env.DOCUMENTS_FIXTURE_ORIGIN}",
					"documents api base path {env.DOCUMENTS_FIXTURE_MOUNT}",
					"documents api realms {env.DOCUMENTS_FIXTURE_REALM}",
					"documents api max file bytes {env.DOCUMENTS_FIXTURE_BYTES}"
				]
			}
		}
	}
}
