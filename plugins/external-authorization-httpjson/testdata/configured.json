{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "app.example.test"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "gatekeeper_name": "app_policy",
                                  "handler": "authorization",
                                  "route_matcher": "*"
                                },
                                {
                                  "body": "protected resource",
                                  "handler": "static_response"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "security": {
      "config": {
        "authorization_policies": [
          {
            "name": "app_policy",
            "auth_url_path": "/auth",
            "auth_redirect_query_param": "redirect_url",
            "auth_redirect_status_code": 302,
            "access_list_rules": [
              {
                "conditions": [
                  "match roles viewer"
                ],
                "action": "allow log debug"
              }
            ],
            "raw_crypto_key_store_config": [
              "crypto key verify synthetic-external-authorization-fixture-key"
            ],
            "crypto_key_store_config": {
              "raw_key_configs": [
                "crypto key verify synthetic-external-authorization-fixture-key"
              ],
              "auto_generate_tag": "default",
              "auto_generate_algo": "ES512"
            },
            "validate_bearer_header": true,
            "api_key_header_name": "X-Api-Key",
            "auth_realm_header_name": "X-Auth-Realm"
          }
        ]
      },
      "external_authorization": [
        {
          "policy": "app_policy",
          "config": {
            "policy": "reports",
            "version": "revision-1",
            "issuer": "https://login.example.test/auth/login",
            "realm": "local",
            "subject_claim": "directory_id",
            "tenant_claim": "tenant",
            "attributes": [
              "roles",
              "department"
            ],
            "timeout": "500ms"
          },
          "backend": {
            "driver": "httpjson",
            "endpoint": "https://policy.example.test/decide",
            "timeout": "500ms",
            "tls": {
              "root_ca_file": "/private roots/ca.pem",
              "client_certificate_file": "/private/client.pem",
              "client_key_file": "/private/client-key.pem"
            }
          }
        }
      ]
    }
  }
}
