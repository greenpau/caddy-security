# Complete Caddy server example. See the repo-local operator-examples reference.
# Supply EXAMPLE_* values through the service environment; never commit credentials.
{
	admin off
	persist_config off
	auto_https off
	log {
		level INFO
		output file "{$EXAMPLE_LOG}"
	}
	security {
		local identity store employeesdb {
			realm employees
			path {$EXAMPLE_EMPLOYEES_DB}
			user alice {
				email alice@example.test
				password {env.EXAMPLE_PASSWORD}
				roles authp/user
			}
		}
		local identity store contractorsdb {
			realm contractors
			path {$EXAMPLE_CONTRACTORS_DB}
			user alice {
				email alice@example.test
				password {env.EXAMPLE_PASSWORD}
				roles authp/user
			}
		}
		local identity store guestsdb {
			realm guests
			path {$EXAMPLE_GUESTS_DB}
			user alice {
				email alice@example.test
				password {env.EXAMPLE_PASSWORD}
				roles authp/user
			}
		}
		oauth registration store {
			path {$EXAMPLE_REGISTRATION_STORE}
		}
		oauth application website {
			registration v1
			redirect_uri https://rp.example.test/callback?registered=yes
			scopes openid profile email
		}
		oauth application browser_app {
			client_id public
			token_endpoint_auth_method none
			redirect_uri https://rp.example.test/callback?registered=yes
			scopes openid profile email
		}
		authentication portal myportal {
			enable identity stores employeesdb contractorsdb guestsdb
			crypto key access sign-verify from file "{$EXAMPLE_ACCESS_KEY}"
			cookie path /auth
			token refresh {
				realms employees contractors
				public origin {$EXAMPLE_ORIGIN}
				base path /auth
				body transport enabled
				access lifetime 300
				idle timeout 600
				absolute timeout 1800
				max sessions 32
			}
			oidc provider {
				issuer {$EXAMPLE_ORIGIN}/auth
				realms employees contractors
				signing key files "{$EXAMPLE_OP_KEY}"
				applications website browser_app
			}
		}
		authentication portal second {
			enable identity stores employeesdb contractorsdb guestsdb
			crypto key access sign-verify from file "{$EXAMPLE_SECOND_ACCESS_KEY}"
			cookie path /other
			cookie prefix SECOND
			cookie refresh token name SECOND_RENEWAL
			token refresh {
				realms employees contractors
				public origin {$EXAMPLE_ORIGIN}
				base path /other
				body transport enabled
				access lifetime 300
				idle timeout 600
				absolute timeout 1800
				max sessions 32
			}
			oidc provider {
				issuer {$EXAMPLE_ORIGIN}/other
				realms employees contractors
				signing key files "{$EXAMPLE_SECOND_OP_KEY}"
				applications website browser_app
			}
		}
		authorization policy app_policy {
			crypto key access verify from file "{$EXAMPLE_ACCESS_PUBLIC_KEY}"
			disable auth redirect
			validate bearer header
			allow roles authp/user resource/editor
		}
	}
}

{$EXAMPLE_ORIGIN} {
	bind 127.0.0.1
	tls "{$EXAMPLE_TLS_CERT}" "{$EXAMPLE_TLS_KEY}"
	@portal path /auth /auth/*
	@second path /other /other/*
	route {
		route @portal {
			authenticate with myportal
		}
		route @second {
			authenticate with second
		}
		route {
			authorize with app_policy
			reverse_proxy {$EXAMPLE_RESOURCE}
		}
	}
}

